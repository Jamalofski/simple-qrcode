{
    "name": "jamalofski/simple-qrcode",
    "description": "Simple QrCode is a QR code generator made for Laravel. Maintained drop-in replacement for simplesoftwareio/simple-qrcode.",
    "keywords": [
        "qrcode",
        "qr-code",
        "laravel",
        "simple",
        "generator",
        "wrapper",
        "bacon"
    ],
    "homepage": "https://github.com/jamalofski/simple-qrcode",
    "license": "MIT",
    "authors": [
        {
            "name": "Simple Software LLC",
            "role": "Original author"
        },
        {
            "name": "Jamal Tantaoui",
            "homepage": "https://github.com/jamalofski",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/jamalofski/simple-qrcode/issues",
        "source": "https://github.com/jamalofski/simple-qrcode"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "simplesoftwareio/simple-qrcode": "self.version"
    },
    "suggest": {
        "ext-imagick": "Needed in png and webp for dot and round styles, eye styles other than square and gradients. Without it, png and webp are rendered with GD: square modules and square eyes only.",
        "illuminate/support": "Allows for use within Laravel."
    },
    "autoload": {
        "psr-4": {
            "SimpleSoftwareIO\\QrCode\\": "src"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "4.4.x-dev"
        },
        "laravel": {
            "providers": [
                "SimpleSoftwareIO\\QrCode\\QrCodeServiceProvider"
            ],
            "aliases": {
                "QrCode": "SimpleSoftwareIO\\QrCode\\Facades\\QrCode"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
